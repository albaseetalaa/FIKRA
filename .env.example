# Site
# Canonical production URL, used for metadataBase (OG/Twitter image resolution).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=

# Server-only. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# AI persistence backend: memory | supabase
# Local development may use memory.
# Production must use supabase with SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Fikra will not silently fall back to temporary memory in production.
AI_PERSISTENCE_PROVIDER=memory
# Optional integration test gate
RUN_SUPABASE_INTEGRATION_TESTS=false
